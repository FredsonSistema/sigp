          {
            "node": "Append no Histórico (BI)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upsert na planilha (Contas)": {
      "main": [
        [
          {
            "node": "Foi pago?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Foi pago?": {
      "main": [
        [
          {
            "node": "Montar comprovante (HTML)",
