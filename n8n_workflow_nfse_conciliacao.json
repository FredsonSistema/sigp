      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json || {}; const dados = body.dados || {}; const documento = body.documento || dados.documento || dados || body; const evento = body.evento || documento.status || 'nfse_lancada'; const itens = Array.isArray(body.itens) ? body.itens : [{ localTipo: documento.localTipo || 'agencia', localNome: documento.localNome || '', localCidade: documento.localCidade || '', valor: Number(documento.valorTotal || documento.valor || 0), status: documento.status || 'PENDENTE' }]; return { json: { evento, timestamp: body.timestamp || new Date().toISOString(), documento, itens, status: dados.status || body.status || documento.status || 'PENDENTE', conciliacao: dados.conciliacao || body.conciliacao || {}, comparacao: dados.comparacao || body.comparacao || {} } };"
      },
