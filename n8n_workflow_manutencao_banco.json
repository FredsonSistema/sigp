{
  "id": "sigpManutencaoBanco",
  "name": "SIGp - Backup e manutenção do banco",
  "nodes": [
    {
      "parameters": {},
      "id": "mb_manual",
      "name": "Executar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 3
            }
          ]
        }
      },
      "id": "mb_diario",
      "name": "Todo dia às 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SIGP_API_URL + '/api/saude/banco/backup' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.SIGP_API_KEY || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "mb_backup",
      "name": "Backup do banco",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SIGP_API_URL + '/api/saude/banco/manutencao' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.SIGP_API_KEY || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "mb_manut",
      "name": "Manutenção do banco",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const backup = $('Backup do banco').first().json || {};\nconst manut = $json || {};\nreturn [{ json: {\n  backupOk: Boolean(backup.ok), arquivo: backup.arquivo || '', bytes: backup.bytes || 0,\n  removidos: (backup.removidos || []).length, erroBackup: backup.error || '',\n  manutencaoOk: Boolean(manut.ok), vacuum: Boolean(manut.vacuum), saude: manut.saude?.status || '',\n  avisos: manut.saude?.avisos || [],\n} }];\n"
      },
      "id": "mb_resumo",
      "name": "Resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    }
  ],
  "connections": {
    "Executar manualmente": {
      "main": [
        [
          {
            "node": "Backup do banco",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Todo dia às 03:00": {
      "main": [
        [
          {
            "node": "Backup do banco",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backup do banco": {
      "main": [
        [
          {
            "node": "Manutenção do banco",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manutenção do banco": {
      "main": [
        [
          {
            "node": "Resumo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}