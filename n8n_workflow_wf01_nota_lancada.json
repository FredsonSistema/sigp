    {
      "parameters": {
        "jsCode": "// Mesmo contrato para importação manual (canal=interface) e integração automática (Praxio/Globus).\nconst body = { ...($input.first().json.body || {}) };\nconst canal = body.canal || 'integracao';\ndelete body.canal;\nif (!body.origem) body.origem = canal === 'interface' ? 'manual' : 'n8n';\n// A validação (campos, duplicidade, valores) é da API SIGp; o status e a mensagem dela voltam ao chamador.\nreturn [{ json: { payload: body } }];"
      },
      "id": "7d3a85f1-48ba-5e71-9981-aca1665a7a75",
      "name": "Preparar documento (contrato v2)",
      "type": "n8n-nodes-base.code",
