# Copie para .env (não versionado) e ajuste. O docker compose lê este arquivo automaticamente.

# Chave exigida em toda escrita na API SIGp (cabeçalho X-API-Key). Vazia = sem autenticação (só desenvolvimento).
# Com chave definida, informe a mesma chave em Configurações > Integração da interface.
SIGP_API_KEY=troque-por-uma-chave-aleatoria-longa

# Origens do navegador autorizadas a chamar a API.
SIGP_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 1 = MATCH só com nota lançada + nota paga + fatura conferida (fluxo alvo). 0 = MATCH com lançada + paga.
SIGP_EXIGIR_FATURA=1

# Webhook do n8n que recebe os eventos da API (conciliação atualizada etc.).
SIGP_N8N_EVENTOS_URL=http://n8n:5678/webhook/sigp-eventos
# Token Bearer enviado pela API ao n8n; configure o mesmo valor na credencial Header Auth do webhook.
SIGP_N8N_TOKEN=

# --- n8n: IA acadêmica experimental e notificações ---
# Deve ser a mesma chave configurada como SIGP_AI_API_KEY no serviço academic-ai.
SIGP_ACADEMIC_AI_KEY=
# Padrão dos e-mails dos alertas (um ou mais, separados por vírgula). O administrador altera em Configurações > Alertas por e-mail,
# que passa a valer no lugar deste. A credencial OAuth do Gmail é criada no editor do n8n.
SIGP_RELATORIO_EMAIL=
# Chat do Telegram que recebe os alertas (a credencial do bot é criada no editor do n8n).
SIGP_TELEGRAM_CHAT_ID=
# WhatsApp via Evolution API: URL completa de sendText, número de destino e apikey da instância.
SIGP_WHATSAPP_URL=
SIGP_WHATSAPP_NUMERO=
SIGP_WHATSAPP_APIKEY=
# OCR: raízes de CNPJ das empresas do grupo (separadas por vírgula) para abrir PDFs com senha (Brisanet, Claro...).
SIGP_PDF_SENHA_CNPJS=
# Endereços padrão que a tela usa numa instalação nova (Configurações > Integração pode trocar por navegador).
# É o endereço visto pelo NAVEGADOR (ex.: http://IP-do-servidor:5001), não o interno da rede Docker.
SIGP_PUBLIC_API_URL=http://127.0.0.1:5001
SIGP_PUBLIC_N8N_URL=http://127.0.0.1:5678
